{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:agent-tactics:scenario:v1",
  "title": "AgentTactics source scenario v1",
  "description": "Source templates with explicit editions, group references and raw evidence; source IDs require project catalog bindings.",
  "definitions": {
    "point": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 2,
      "maxItems": 2
    },
    "unit": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "characterId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "characterSymbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "classId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "effectiveClassId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "classSymbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "leaderId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "faction": {
          "enum": [
            "player",
            "ally",
            "enemy"
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "autolevel": {
          "type": "boolean"
        },
        "entryPosition": {
          "$ref": "#/definitions/point"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/definitions/point"
            },
            {
              "type": "null"
            }
          ]
        },
        "positionStatus": {
          "enum": [
            "on-map",
            "off-map",
            "unresolved"
          ]
        },
        "route": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position": {
                "$ref": "#/definitions/point"
              },
              "flags": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "a": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "b": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "delayFrames": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            },
            "required": [
              "position",
              "flags",
              "a",
              "b",
              "delayFrames"
            ],
            "additionalProperties": false
          }
        },
        "itemIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "maxItems": 4
        },
        "aiBytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 4,
          "maxItems": 4
        },
        "dropItem": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sourceAddress": {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]{8}$"
        },
        "sourceRecordHex": {
          "type": "string",
          "pattern": "^(?:[0-9A-Fa-f]{2})+$"
        }
      },
      "required": [
        "index",
        "characterId",
        "characterSymbol",
        "classId",
        "effectiveClassId",
        "classSymbol",
        "leaderId",
        "faction",
        "level",
        "autolevel",
        "entryPosition",
        "position",
        "positionStatus",
        "route",
        "itemIds",
        "aiBytes",
        "dropItem",
        "sourceAddress",
        "sourceRecordHex"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
